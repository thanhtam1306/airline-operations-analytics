)

// --- NÚT BẤM TOÀN NĂNG THÔNG MINH (UNIVERSAL MASTER BUTTON) -------
AI Copilot Universal Header URL = 
VAR SelectedFlightID = SELECTEDVALUE ( fct_flight_regulatory_predictions[flight_id] )
VAR SelectedCarrier = COALESCE ( SELECTEDVALUE ( fct_flight_regulatory_predictions[carrier_code] ), SELECTEDVALUE ( dim_airline[carrier_code] ) )
VAR SelectedOrigin = COALESCE ( SELECTEDVALUE ( fct_flight_regulatory_predictions[origin] ), SELECTEDVALUE ( dim_airport[airport_code] ) )
RETURN
IF (
    NOT ISBLANK ( SelectedFlightID ),
    "http://skyops.local:8000/embed/chat?page=4&flight_id=" & SelectedFlightID,
    IF (
        NOT ISBLANK ( SelectedOrigin ),
        "http://skyops.local:8000/embed/chat?page=3&origin=" & SelectedOrigin,
        IF (
            NOT ISBLANK ( SelectedCarrier ),
            "http://skyops.local:8000/embed/chat?page=2&carrier=" & SelectedCarrier,
            "http://skyops.local:8000/embed/chat?page=1"
        )
    )
)

AI Copilot Universal Header Tooltip = 
VAR SelectedFlightID = SELECTEDVALUE ( fct_flight_regulatory_predictions[flight_id] )
RETURN
IF (
    NOT ISBLANK ( SelectedFlightID ),
    "Mở Trợ lý SkyOps AI phân tích chuyên sâu cho Chuyến bay #" & SelectedFlightID,
    "Mở Trợ lý SkyOps AI Copilot (Khung chat nhúng siêu gọn đa năng 4 trang)"
)

AI Copilot Universal Header Label = "🤖 SkyOps AI Copilot"

